    "aad1eb43": {
      "text": "Look around the classroom. Every classmate has something special to share. They are different, and each person matters.",
      "lang": "en",
      "file": "unit2-05.mp3",
      "start": 5.56,
      "duration": 6.9333,
      "speed": 0.94,
      "listened": false,
      "contentReview": "pending"
    },
    "e5c4d9fa": {
      "text": "Shenshen hopes to be a writer, while Xiaojiang wants to be a painter. They enjoy sharing their work with one another.",
      "lang": "en",
      "file": "unit2-05.mp3",
      "start": 12.8433,
      "duration": 7.0187,
      "speed": 0.94,
      "listened": false,
      "contentReview": "pending"
    },
    "424780f7": {
      "text": "Minmin plays football well. Xiaopu is good at basketball. Their classmates cheer for both of them.",
      "lang": "en",
      "file": "unit2-05.mp3",
      "start": 20.212,
      "duration": 5.9733,
      "speed": 0.94,
      "listened": false,
      "contentReview": "pending"
    },
    "73043472": {
      "text": "Yaoyao is polite and helpful. She uses polite words and often helps James learn Chinese. Her actions show what she is like.",
      "lang": "en",
      "file": "unit2-05.mp3",
      "start": 26.5353,
      "duration": 8.1493,
      "speed": 0.94,
      "listened": false,
      "contentReview": "pending"
    },
    "45f78462": {
      "text": "The class is playing a guessing game. Shenshen gives clues about a classmate without saying his name.",
      "lang": "en",
      "file": "unit2-05.mp3",
      "start": 35.0347,
      "duration": 5.824,
      "speed": 0.94,
      "listened": false,
      "contentReview": "pending"
    },
