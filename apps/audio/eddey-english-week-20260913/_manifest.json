      "end": 2.448
    },
    {
      "id": "f41e7f7e",
      "lang": "en-US",
      "text": "I like the library in my school best.",
      "file": "voice-13.mp3",
      "start": 2.928,
      "end": 5.232
    },
    {
      "id": "6322d465",
      "lang": "en-US",
      "text": "It is on the ground floor. It is very special.",
      "file": "voice-13.mp3",
      "start": 5.712,
      "end": 8.528
    },
    {
      "id": "2424e162",
      "lang": "en-US",
      "text": "It",
      "file": "voice-13.mp3",
      "start": 9.008,
      "end": 9.5627
    },
    {
      "id": "72636263",
      "lang": "en-US",
      "text": "very",
