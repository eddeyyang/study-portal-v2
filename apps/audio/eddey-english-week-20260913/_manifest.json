      "end": 8.6773
    },
    {
      "id": "fd66579e",
      "lang": "en-US",
      "text": "An artist plays the guitar on the beach in the morning.",
      "file": "voice-15.mp3",
      "start": 9.1573,
      "end": 12.0373
    },
    {
      "id": "2088c75e",
      "lang": "en-US",
      "text": "We have no computers.",
